{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "typeOfUser": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Initiator", "Reviewer", "Decision Maker", "Strategic", "Policy Maker"]
      }
    },

    "learningMode": {
      "type": "string",
      "enum": ["self-paced", "instructor-led"]
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "referenceLink": {
      "type": "string"
    },
    "requestType": {
      "type": "string",
      "enum": ["Broadcast", "Single"]
    },
    "preferredProvider": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assignedProvider": {
        "type": "object"
    },
    "demand_id": {
      "type": "string"
    },

    "proficiencyLevel": {
      "type": "string",
      "enum": ["Beginner", "Intermediate", "Advanced"]
    },

    "estimatedDuration": {
      "type": "string",
      "pattern": "^([0-9]{2}):([0-9]{2}):([0-9]{2})$",
      "description": "hh:mm:ss"
    },

    "courseLanguage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "sectoralSubjectMatterExpertAvailable": {
      "type": "boolean",
      "description": "Yes/No - Sectoral Subject Matter Expert available with MDO"
    },

    "sectoralSubjectMatterExpertDetails": {
      "type": "array",
      "description": "Required only if SME available = Yes",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "number": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        },
        "required": ["name", "number", "email"]
      }
    },

    "courseDigitisationAgencyRequired": {
      "type": "boolean",
      "description": "Yes/No - Digitisation agency required from Karmayogi Bharat"
    }

  },

  "required": [
    "title",
    "objective",
    "requestType"
  ],

  "allOf": [
    {
      "if": {
        "properties": {
          "sectoralSubjectMatterExpertAvailable": {
            "const": true
          }
        },
        "required": ["sectoralSubjectMatterExpertAvailable"]
      },
      "then": {
        "required": ["sectoralSubjectMatterExpertDetails"],
        "properties": {
          "sectoralSubjectMatterExpertDetails": {
            "minItems": 1
          }
        }
      }
    }
  ]
}